# Exclude the package itself (prevents circular bloat)
*.s9pk

# Exclude Docker build artifacts
docker-images/
image.tar.gz
*.tar.gz
Dockerfile
.dockerignore

# Exclude node_modules (will be installed fresh inside container)
node_modules/

# Exclude build output
build/

# Exclude dev/test files
tests/
*.log
*.md
releases/

# Exclude secrets
.env
.env.*

# Exclude local database (contains real user data; live DB lives on /app/data)
database/*.db

# Exclude git
.git/
.gitignore
